{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-lingui"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "lingui/t-call-in-function": "error",
    "lingui/no-single-tag-to-translate": "error",
    "lingui/no-single-variables-to-translate": "error",
    "lingui/no-trans-inside-trans": "error",
    "lingui/no-expression-in-message": "error",
    "lingui/no-unlocalized-strings": [
      "error",
      {
        "ignore": [
          "^[^A-Za-z]*$",
          "^[a-z0-9_.:/#@\\-]+$",
          "^[a-z]+[A-Z][A-Za-z0-9]*$",
          "^hew[.:]",
          "^settings-",
          "^(var|calc|color-mix|rgba?|hsla?|url|env|min|max|clamp|translate[XYZ]?|rotate|scale|linear-gradient|radial-gradient|cubic-bezier|repeat|minmax)\\(",
          "^-?[0-9.]+(px|%|em|rem|vh|vw|fr|s|ms|deg)?( |$)",
          "^(auto|none|inherit|initial|transparent|currentColor|solid|dashed|dotted|flex|grid|block|inline|inline-block|absolute|relative|fixed|sticky|hidden|visible|scroll|pointer|default|nowrap|wrap|center|start|end|stretch|baseline|bold|normal|italic|uppercase|lowercase|capitalize|ellipsis|contain|cover|both|row|column|manipulation|border-box|content-box|break-word|pre|pre-wrap|monospace|sans-serif|serif|ui-monospace|system-ui)( |$)",
          "^</?[a-z]+[ >/]",
          "^[A-Z][A-Za-z0-9]*_",
          "^Unknown$"
        ],
        "ignoreNames": [
          "LOCALE_NAMES",
          "PSEUDO_LOCALE",
          "className",
          "id",
          "key",
          "type",
          "role",
          "href",
          "src",
          "style",
          "name",
          "htmlFor",
          "shortcut",
          "fontFamily",
          "font",
          "fontWeight",
          "fontSize",
          "lineHeight",
          "letterSpacing",
          "textTransform",
          "textAlign",
          "textDecoration",
          "whiteSpace",
          "wordBreak",
          "overflowWrap",
          "padding",
          "paddingTop",
          "paddingRight",
          "paddingBottom",
          "paddingLeft",
          "margin",
          "marginTop",
          "marginRight",
          "marginBottom",
          "marginLeft",
          "inset",
          "top",
          "right",
          "bottom",
          "left",
          "width",
          "height",
          "minWidth",
          "minHeight",
          "maxWidth",
          "maxHeight",
          "gap",
          "rowGap",
          "columnGap",
          "border",
          "borderTop",
          "borderRight",
          "borderBottom",
          "borderLeft",
          "borderRadius",
          "borderColor",
          "outline",
          "background",
          "backgroundColor",
          "backgroundImage",
          "color",
          "fill",
          "stroke",
          "strokeDasharray",
          "boxShadow",
          "textShadow",
          "transform",
          "transformOrigin",
          "transition",
          "animation",
          "gridTemplateColumns",
          "gridTemplateRows",
          "gridColumn",
          "gridRow",
          "gridArea",
          "flex",
          "flexFlow",
          "placeItems",
          "placeContent",
          "justifyContent",
          "alignItems",
          "alignSelf",
          "justifySelf",
          "objectFit",
          "pointerEvents",
          "userSelect",
          "touchAction",
          "cursor",
          "zIndex",
          "opacity",
          "filter",
          "backdropFilter",
          "mixBlendMode",
          "clipPath",
          "mask",
          "scrollbarWidth",
          "WebkitAppRegion",
          "WebkitTapHighlightColor",
          "WebkitOverflowScrolling",
          "viewBox",
          "d",
          "points",
          "xmlns",
          "rel",
          "target",
          "method",
          "enctype",
          "accept",
          "download",
          "inputMode",
          "autoComplete",
          "autoCapitalize",
          "charset",
          "testid",
          "content",
          "pattern",
          "mimeType",
          "mime",
          "ext",
          "extension",
          "extensions",
          "path",
          "url",
          "origin",
          "hash",
          "event",
          "channel",
          "command",
          "code",
          "kind",
          "op",
          "mode",
          "variant",
          "icon",
          "iconName",
          "glyph",
          "symbol",
          "tag",
          "format",
          "unit",
          "locale",
          "lang",
          "version",
          "storageKey",
          "STORAGE_KEY",
          { "regex": { "pattern": "^data-", "flags": "" } },
          { "regex": { "pattern": "^aria-(?!label$|description$|placeholder$)", "flags": "" } }
        ],
        "ignoreFunctions": [
          "console.*",
          "kernelErrorMessage",
          "log.*",
          "*.log.*",
          "LogStore.log.*",
          "setActiveTool",
          "activateTool",
          "toolLabel",
          "keyFor",
          "onSelectTool",
          "*.onSelectTool",
          "noteOpenFailure",
          "logUi",
          "append",
          "logStore.append",
          "diag.*",
          "*.addEventListener",
          "*.removeEventListener",
          "*.getItem",
          "*.setItem",
          "*.removeItem",
          "*.hasAttribute",
          "*.getAttribute",
          "*.setAttribute",
          "*.querySelector",
          "*.querySelectorAll",
          "*.closest",
          "*.matches",
          "*.startsWith",
          "*.endsWith",
          "*.includes",
          "*.split",
          "*.replace",
          "*.emit",
          "*.listen",
          "Error",
          "new Error",
          "describe",
          "it",
          "test",
          "expect"
        ]
      }
    ]
  },
  "ignorePatterns": ["src/wasm/pkg/**", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**", "e2e/**", "src/locales/**"]
}
